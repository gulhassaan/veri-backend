# Server
PORT=8787

# Gemini API key - held ONLY here, server-side. Never shipped in the
# extension per the spec's "no third-party secret/API keys embedded in
# the extension" requirement.
# Get a free key (no card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# 'gemini-flash-latest' is a rolling alias Google maintains - more
# resilient than pinning a version number, which has been unreliable for
# brand-new API keys.
ANALYSIS_MODEL=gemini-flash-latest

# Tavily API key - the actual web-search evidence provider. NOT Gemini's
# own Google Search grounding tool, which requires billing even within
# its nominal "free allowance" for new accounts (confirmed via testing).
# Get a free key (1,000 credits/month, no card required) at https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here
MAX_SEARCH_QUERIES_PER_CLAIM=2
MAX_RESULTS_PER_QUERY=4

ANALYSIS_VERSION=1.0.0
CACHE_TTL_HOURS=336
MAX_TRANSCRIPT_CHARS=20000
MAX_CLAIMS_PER_VIDEO=8

WEIGHT_ACCURACY=40
WEIGHT_EVIDENCE=25
WEIGHT_SOURCES=20
WEIGHT_CONTEXT=15

CLIENT_ORIGINS=chrome-extension://*
DB_PATH=./data/db.json
